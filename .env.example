# PostgreSQL connection (local dev)
DATABASE_URL=postgresql://attractbirds_app:change-me@127.0.0.1:5432/attractbirds

# eBird API key — free at https://ebird.org/api/keygen
EBIRD_API_KEY=

# GBIF — no key required for read-only queries
# GBIF_USER=
# GBIF_PASSWORD=

# Optional: Macaulay Library (Cornell) — for audio in future
# MACAULAY_API_KEY=
